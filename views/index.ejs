<!DOCTYPE html>
<html>

<head>
  <title>TacoCraft</title>
  <link rel="stylesheet" type="text/css" href="/styles/main.css">
</head>

<body>
  <div class="app-container">

    <button id="cartToggle" class="cart-icon" aria-label="View cart">
      🛒 <span id="cartCount">0</span>
    </button>

    <h1>🌮 TacoCraft 🌮</h1>

    <div class="ingredient-buttons">
      <button data-choice="chicken">🍗</button>
      <button data-choice="beef">🥩</button>
      <button data-choice="fish">🐟</button>
      <button data-choice="shrimp">🍤</button>
      <button data-choice="pork">🐖</button>
      <button data-choice="veggie">🌱</button>
    </div>

    <div id="recipeContainer">
      <h2 class="pick_your_fav">👆 Pick your favourite taco ingredient 👆</h2>
    </div>

  </div>

  <div id="cartPanel" class="cart-panel">
    <h2>Your Cart</h2>
    <ul id="cartItems"></ul>
    <p id="cartTotal">Total: $0.00</p>
    <button id="checkoutBtn">Checkout</button>
    <button id="closeCart">Close</button>
  </div>

  <div id="cartOverlay" class="cart-overlay"></div>

  <script src="/script.js"></script>

</body>

</html>